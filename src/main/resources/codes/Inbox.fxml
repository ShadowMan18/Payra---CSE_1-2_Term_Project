<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<StackPane fx:id="InboxLayout" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="codes.Client.InboxController">
   <Group fx:id="InboxView">
      <ImageView pickOnBounds="true">
         <Image url="@../images/Inbox.png" />
      </ImageView>
      <ImageView fx:id="userProfilePictureView" fitHeight="70.0" fitWidth="70.0" layoutX="12.0" layoutY="112.0" pickOnBounds="true" preserveRatio="true" />
      <Button layoutX="8.0" layoutY="691.0" mnemonicParsing="false" onAction="#onNewsFeedButtonClicked" opacity="0.0" prefHeight="96.0" prefWidth="78.0" style="-fx-background-radius: 0;" text="Button" textFill="TRANSPARENT" />
      <Button layoutX="17.0" layoutY="345.0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#onHomeButtonClicked" prefHeight="56.0" prefWidth="56.0" styleClass="button3" text="Button" textFill="TRANSPARENT" />
      <Button layoutX="17.0" layoutY="456.0" mnemonicParsing="false" onAction="#onNotificationButtonClick" prefHeight="56.0" prefWidth="56.0" styleClass="button3" text="Button" textFill="TRANSPARENT" />
      <TextField fx:id="SearchBar" layoutX="141.0" layoutY="120.0" onKeyTyped="#searchUser" prefHeight="46.0" prefWidth="323.0" promptText="Search" style="-fx-background-color: transparent; -fx-font-family: Open Sans; -fx-font-size: 18; -fx-font-weight: bold" />
      <Label fx:id="noUserFoundLabel" alignment="CENTER" contentDisplay="CENTER" layoutX="128.0" layoutY="182.0" prefHeight="30.0" prefWidth="385.0" style="-fx-font-family: Open Sans; -fx-font-weight: bold; -fx-font-size: 15" text="No user found" textAlignment="CENTER" textFill="#c7c7c7" />
      <ImageView fx:id="ChatBox" fitHeight="900.0" fitWidth="1064.0" layoutX="536.0" pickOnBounds="true" preserveRatio="true" />
      <Button layoutX="1513.0" layoutY="816.0" mnemonicParsing="false" onAction="#onSendButtonClicked" opacity="0.0" prefHeight="36.0" prefWidth="36.0" style="-fx-background-radius: 18px;" styleClass="text-button" text="Button" textFill="TRANSPARENT" />
      <Button layoutX="586.0" layoutY="816.0" mnemonicParsing="false" onAction="#onAttachButtonClicked" opacity="0.0" prefHeight="36.0" prefWidth="36.0" style="-fx-background-radius: 18px;" styleClass="text-button" text="Button" textFill="TRANSPARENT" />
      <Group fx:id="receiverInfo" layoutX="558.0" layoutY="24.0">
         <children>
            <StackPane prefHeight="60.0" prefWidth="300.0">
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="300.0" spacing="10.0">
                     <children>
                        <ImageView fx:id="receiverProfilePictureView" fitHeight="50.0" fitWidth="50.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true" />
                        <VBox prefHeight="50.0" prefWidth="264.0">
                           <children>
                              <Label fx:id="ReceiverName" prefHeight="62.0" prefWidth="219.0" style="-fx-font-family: Open Sans; -fx-font-size: 18; -fx-font-weight: bold;" />
                              <HBox fx:id="activeStatus" alignment="CENTER" maxHeight="-Infinity" prefHeight="20.0" prefWidth="200.0" spacing="5.0">
                                 <children>
                                    <Circle fill="#31d122" radius="4.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" />
                                    <Label prefHeight="18.0" prefWidth="244.0" style="-fx-font-family: Open Sans; -fx-font-size: 12; -fx-text-fill: #0f2e4d;" text="Active now" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </HBox>
               </children>
            </StackPane>
         </children>
      </Group>
      <Group fx:id="callButtons" layoutX="1424.0" layoutY="26.0">
         <children>
            <HBox prefHeight="55.0" prefWidth="130.0" spacing="20.0">
               <children>
                  <Rectangle arcHeight="25.0" arcWidth="25.0" fill="WHITE" height="55.0" width="55.0" style="-fx-effect: dropshadow(gaussian, rgba(0, 0, 5, 0.4), 4, 0.2, 0, 2);" />
                  <Rectangle arcHeight="25.0" arcWidth="25.0" fill="WHITE" height="55.0" width="55.0" style="-fx-effect: dropshadow(gaussian, rgba(0, 0, 5, 0.4), 4, 0.2, 0, 2);" />
               </children>
            </HBox>
            <ImageView fitHeight="43.0" fitWidth="43.0" layoutX="6.0" layoutY="6.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/AudioCall.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="50.0" fitWidth="50.0" layoutX="80.0" layoutY="2.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/VideoCall.png" />
               </image>
            </ImageView>
            <Button mnemonicParsing="false" onAction="#onAudioCallButtonClicked" prefHeight="55.0" prefWidth="55.0" styleClass="text-button" />
            <Button layoutX="75.0" mnemonicParsing="false" onAction="#onVideoCallButtonClicked" prefHeight="55.0" prefWidth="55.0" styleClass="text-button" />
         </children>
      </Group>
      <TextField fx:id="Message" layoutX="726.0" layoutY="811.0" onKeyPressed="#onEnterKeyPressed" prefHeight="46.0" prefWidth="751.0" promptText="Type your message..." style="-fx-font-family: Open Sans; -fx-font-size: 18; -fx-font-weight: bold;" styleClass="text-field1" />
      <Button layoutX="653.0" layoutY="816.0" mnemonicParsing="false" onAction="#onEmojiButtonClick" opacity="0.0" prefHeight="36.0" prefWidth="36.0" style="-fx-background-radius: 18px;" styleClass="text-button" text="Button" textFill="TRANSPARENT" />
      <ScrollPane fx:id="MessageScroller" fitToWidth="true" hbarPolicy="NEVER" layoutX="600.0" layoutY="97.0" prefHeight="682.0" prefWidth="936.0" style="-fx-background-color: transparent;" vbarPolicy="NEVER">
         <content>
            <VBox fx:id="MessageContainer" spacing="3.0" styleClass="vbox" />
         </content></ScrollPane>
      <ScrollPane fx:id="InboxScroller" fitToWidth="true" hbarPolicy="NEVER" layoutX="128.0" layoutY="221.0" prefHeight="660.0" prefWidth="385.0" style="-fx-background-color: transparent;" vbarPolicy="NEVER">
         <content>
            <VBox fx:id="InboxContainer" spacing="5.0" styleClass="vbox" />
         </content>
      </ScrollPane>
      <Circle fx:id="notificationDot" fill="#cc0b0b" layoutX="55.0" layoutY="467.0" radius="7.0" stroke="BLACK" strokeType="INSIDE" />
      <!--         <TextField fx:id="Recipient" layoutX="187.0" layoutY="431.0" onKeyReleased="#getRecipientId" prefHeight="38.0" prefWidth="263.0" />-->
   </Group>
   <stylesheets>
      <URL value="@../Styles.css" />
      <URL value="@../PageStyle.css" />
   </stylesheets>
</StackPane>
