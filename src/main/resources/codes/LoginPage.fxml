<StackPane fx:id="LoginPageLayout" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" onKeyReleased="#onEnterKeyPress" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="codes.LoginPageController">
   <children>
      <Group fx:id="LoginPageView">
         <ImageView pickOnBounds="true">
            <image>
               <Image url="@../images/LoginPage.png" />
