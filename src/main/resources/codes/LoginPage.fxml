            </font>
         </Label>
         <Label fx:id="LoginPagePasswordLabel" layoutX="1276.0" layoutY="439.0" prefHeight="54.0" prefWidth="300.0" textFill="RED" wrapText="true">
            <font>
               <Font name="System Bold Italic" size="15.0" />
            </font>
         </Label>
      </Group>
