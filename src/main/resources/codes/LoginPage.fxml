         </ImageView>
         <Button layoutX="740.0" layoutY="561.0" mnemonicParsing="false" onAction="#onLoginButtonClick" onKeyReleased="#onEnterKeyPress" opacity="0.0" prefHeight="49.0" prefWidth="159.0" style="-fx-background-radius: 0;" text="Button" textFill="TRANSPARENT" />
         <Button layoutX="741.0" layoutY="644.0" mnemonicParsing="false" onAction="#onForgotPasswordButtonClick" opacity="0.0" prefWidth="159.0" text="Button" textFill="TRANSPARENT" />
         <Button layoutX="1017.0" layoutY="745.0" mnemonicParsing="false" onAction="#onCreateButtonClick" opacity="0.0" prefHeight="10.0" prefWidth="137.0" text="Button" textFill="TRANSPARENT" />
         <TextField fx:id="LoginPageEmailField" layoutX="750.0" layoutY="280.0" prefHeight="53.0" prefWidth="504.0" style="-fx-background-color: tranperant; -fx-font-family: Glacial Indifference; -fx-font-size: 24; -fx-font-weight: bold;" />
